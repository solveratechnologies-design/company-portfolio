# ---------------------------------------------------------------
# Solvera Technologies — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------

# Public site origin: the ONE authoritative URL used for canonical links, sitemap.xml, robots.txt,
# Open Graph and JSON-LD. Origin only (no path), e.g. https://www.your-domain.com
# - REQUIRED for production builds: `next build` fails with an explicit error if it is empty or not https.
# - Optional in development: falls back to http://localhost:3000.
# - Inlined at BUILD time, so it must be set in the build environment, not only on the running server.
NEXT_PUBLIC_SITE_URL=

# Content source. "static" uses the files in src/data. "dynamic" loads JSON from CONTENT_API_URL.
# Switching this one value changes every page. Pages stay server-rendered either way.
CONTENT_MODE=static
# Full URL of the content endpoint, required when CONTENT_MODE=dynamic.
# Expected JSON keys (each optional; omitted keys keep the static copy):
# services, projects, articles, industries, testimonials, processPhases, detailedPhases, faqGroups, contactFaqs
CONTENT_API_URL=
# Optional bearer token sent with the content request.
CONTENT_API_TOKEN=

# Hide sections without editing page files. Comma-separated page:section pairs.
# Example: home:testimonials,home:insights,about:process
# Section ids live in src/config/sections.ts. Setting a flag there to false also hides it.
HIDDEN_SECTIONS=

# Verified public contact details. Leave empty to hide them everywhere.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Verified social profiles, comma-separated "Label|https://url" pairs. Leave empty to hide.
# Example: LinkedIn|https://www.linkedin.com/company/your-company,GitHub|https://github.com/your-org
NEXT_PUBLIC_SOCIAL_LINKS=

# --- Contact form delivery (configure ONE option; server-side only) ---

# Option A: Resend email API (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Solvera Website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Option B: Webhook (n8n, Make, Zapier, GoHighLevel inbound webhook, or your own CRM endpoint)
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
CONTACT_WEBHOOK_SECRET=
# The webhook URL must be https (http is accepted only for localhost test receivers).
# A 2xx response is the only thing treated as "accepted"; redirects are not followed.

# --- Contact form abuse protection (server-side only) ---

# Name of the request header that YOUR reverse proxy / CDN sets (and overwrites) with the real client IP,
# e.g. cf-connecting-ip, x-real-ip, x-vercel-forwarded-for, or x-forwarded-for (right-most entry is used).
# Leave empty if unsure: client-supplied X-Forwarded-For is then ignored and all visitors share one
# flood-protection bucket (cannot be spoofed, but less precise). Rate limits are per server instance
# unless you register a shared store with setRateLimitStore() (see README).
CONTACT_CLIENT_IP_HEADER=

# Set to "true" to send the Content-Security-Policy as report-only while evaluating a change.
CSP_REPORT_ONLY=

# --- Legal pages (privacy policy, terms, cookie policy) ---
# These pages stay noindex, are left out of sitemap.xml and show a "template" notice until EVERY value
# below is provided and LEGAL_COUNSEL_REVIEWED=true. Supply only facts that are true; have counsel review
# the final text. Server-side only; set in the build environment.
LEGAL_ENTITY_NAME=
LEGAL_REGISTERED_ADDRESS=
# Governing law / jurisdiction for the Terms, e.g. the state or country whose law applies.
LEGAL_JURISDICTION=
# Effective date of the policies, written as you want it displayed.
LEGAL_EFFECTIVE_DATE=
# How long inquiry data is kept, e.g. "24 months after the last contact".
LEGAL_RETENTION_PERIOD=
# Providers that process inquiry data (email/webhook provider, hosting), as a sentence fragment.
LEGAL_SERVICE_PROVIDERS=
# Set to "true" only after qualified counsel has reviewed and approved the final text.
LEGAL_COUNSEL_REVIEWED=
